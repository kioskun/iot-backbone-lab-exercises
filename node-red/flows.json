  {
    "id": "7813493fccb00c2a",
    "type": "function",
    "z": "8bbf5f6b837b51db",
    "name": "function 1",
    "func": "let data = msg.payload.uplink_message.decoded_payload;\n\nlet temp = data.DHT_Temp;   // Temperature\nlet hum = data.DHT_Hum;    // Humidity\nlet photo = data.Photo;      // Photoresistor value (numeric)\nlet led = (photo < 2000) ? 1 : 0; // LED value (ensure it's a number)\n\nreturn [\n    { payload: temp },\n    { payload: hum },\n    { payload: photo },\n    { payload: led }\n];\n",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
